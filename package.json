{
  "name": "fastcharger",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx worker/src/jobs/data-platform.ts migrate",
    "sync:india": "tsx worker/src/jobs/data-platform.ts ocm",
    "discover:cities": "tsx --conditions react-server scripts/discovery/discover-cities.ts",
    "graph:3d": "node graphify-out/3d/serve.js",
    "import:research-stations": "tsx worker/src/jobs/data-platform.ts import",
    "data:profile": "tsx worker/src/jobs/data-platform.ts profile",
    "data:migrate": "tsx worker/src/jobs/data-platform.ts migrate",
    "sync:providers": "tsx worker/src/jobs/data-platform.ts sync",
    "sync:status": "tsx worker/src/jobs/data-platform.ts status",
    "sync:ocm": "tsx worker/src/jobs/data-platform.ts ocm",
    "sync:bee": "tsx worker/src/jobs/data-platform.ts bee",
    "data:admin": "tsx worker/src/jobs/data-platform.ts admin",
    "typecheck": "tsc --noEmit",
    "data:scheduler:install": "tsx worker/src/jobs/install-scheduler.ts",
    "data:scheduled": "tsx worker/src/jobs/scheduled-run.ts",
    "data:verify": "tsx worker/src/jobs/verify-data.ts",
    "data:quarantine-fixtures": "tsx worker/src/jobs/quarantine-fixtures.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@hono/node-server": "^2.1.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "leaflet": "^1.9.4",
    "mongodb": "^7.7.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "redis": "^6.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
