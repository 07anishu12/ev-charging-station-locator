# PostgreSQL connection string with PostGIS enabled
# Example: postgresql://postgres:postgres@localhost:5432/fastcharger
# Local Docker defaults. A native/hosted PostgreSQL + PostGIS URL also works.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/fastcharger
# Optional for future refreshes; the bundled dataset needs no provider key.
OCM_API_KEY=
OPENCHARGEMAP_API_KEY=
# Server-only backend destination. Browsers use the frontend's /api/v1 proxy.
API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: BACKEND_PORT=4000, FRONTEND_PORT=3000
# Optional real CSV import: RESEARCH_STATIONS_FILE=/absolute/path/india-master.csv
